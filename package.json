  "description": "Open-source, local-first context reader for English reading in Chrome and Edge.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/royal-byte/ai-context-reader.git"
  },
  "homepage": "https://github.com/royal-byte/ai-context-reader#readme",
