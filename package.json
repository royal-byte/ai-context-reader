  },
  "devDependencies": {
    "@types/chrome": "^0.1.27",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.2.2",
    "jsdom": "^30.1.3",
    "prettier": "^3.6.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "wxt": "^0.21.4"
  }
